{
  "name": "@ci-dokumentor/source",
  "version": "0.2.1",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "nx run-many --target=build --all --parallel --exclude=@ci-dokumentor/source",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "lint:ci": "report_dir=\"${CI_REPORTS_DIR:-.reports}\"; mkdir -p \"$report_dir\"; biome lint . --reporter=sarif --reporter-file=\"$report_dir/lint.sarif\"",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "nx run-many --target=test --all --parallel --exclude=@ci-dokumentor/source",
    "test:ci": "vitest run --coverage.enabled=\"${CI_TEST_COVERAGE:-true}\" --coverage.reporter=lcov --coverage.reporter=text --coverage.reportsDirectory=\"${CI_REPORTS_DIR:-.reports}/coverage\" --reporter=default --reporter=junit --outputFile.junit=\"${CI_REPORTS_DIR:-.reports}/junit.xml\"",
    "all": "pnpm run build && pnpm run lint:fix && pnpm run test:ci",
    "docs:start": "nx start @ci-dokumentor/docs",
    "docs:serve": "nx serve @ci-dokumentor/docs",
    "docs:clear": "nx clear @ci-dokumentor/docs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@nx/js": "24.0.6",
    "@nx/vite": "24.0.6",
    "@nx/vitest": "24.0.6",
    "@nx/web": "24.0.6",
    "@swc-node/register": "~1.12.1",
    "@swc/core": "~1.16.22",
    "@swc/helpers": "~0.5.24",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/ui": "^5.1.1",
    "jiti": "2.7.0",
    "jsdom": "~31.0.1",
    "nx": "24.0.6",
    "tslib": "^2.9.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "^8.3.8",
    "vite-plugin-dts": "~5.1.2",
    "vitest": "^5.1.1"
  },
  "workspaces": [
    "packages/*"
  ]
}
