{
  "name": "@ci-dokumentor/source",
  "version": "0.2.1",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "nx run-many --target=build --all --parallel --exclude=@ci-dokumentor/source",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "lint:ci": "biome lint . --reporter=json-pretty --reporter-file=biome-report.json",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "nx run-many --target=test --all --parallel --exclude=@ci-dokumentor/source",
    "test:ci": "nx run-many --target=test --all --parallel --exclude=@ci-dokumentor/source --coverage",
    "all": "pnpm run build && pnpm run lint:fix && pnpm run test:ci",
    "docs:start": "nx start @ci-dokumentor/docs",
    "docs:serve": "nx serve @ci-dokumentor/docs",
    "docs:clear": "nx clear @ci-dokumentor/docs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@nx/js": "23.2.1",
    "@nx/vite": "23.2.1",
    "@nx/vitest": "23.2.1",
    "@nx/web": "23.2.1",
    "@swc-node/register": "~1.12.1",
    "@swc/core": "~1.16.2",
    "@swc/helpers": "~0.5.23",
    "@types/mock-fs": "^4.13.4",
    "@types/node": "26.4.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "jiti": "2.7.0",
    "jsdom": "~30.1.0",
    "mock-fs": "^5.5.0",
    "nx": "23.2.1",
    "tslib": "^2.8.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-dts": "~5.1.0",
    "vitest": "^5.0.1"
  },
  "workspaces": [
    "packages/*"
  ]
}
